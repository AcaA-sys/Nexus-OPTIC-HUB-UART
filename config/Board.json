    "frequency_sysclk_mhz": 170,
    "hse_crystal_mhz": 24
  },
  "network_protocol": {
    "name": "N-Bus (grblHAL Architecture)",
    "interface": "FDCAN1_Normal_Mode",
    "bitrate_arbitration_mbit": 1.0,
    "bitrate_data_mbit": 4.0,
    "fdcan_clock_source_mhz": 80.0
